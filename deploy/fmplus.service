[Unit]
Description=FM Plus vehicle metrics
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/fmplus/fmplus
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=3
Environment=NODE_ENV=production
# server.mjs also reads .env.local from WorkingDirectory

[Install]
WantedBy=multi-user.target
