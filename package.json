{
  "name": "fms-embed",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haryowl/fmplus.git"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server.mjs",
    "test": "vitest run",
    "db:up": "docker compose up -d postgres minio minio-init",
    "db:down": "docker compose down",
    "db:migrate": "node server/db/migrate.mjs",
    "probe:armada": "node scripts/probe-armada-apis.mjs",
    "osrm:up": "docker compose --profile osrm up -d osrm",
    "apk:sync": "npm run build && npx cap sync android",
    "apk:debug": "node scripts/apk-debug.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.901.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "chart.js": "^4.5.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
