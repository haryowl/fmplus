# Server-side only (Vite proxy and `npm start`). Do not prefix with VITE_ — that would expose it to the browser.
# Copy this file to .env.local and paste the Authorization header value.
ARMADA_AUTH_HEADER=v2:your-token-here

# GpsGate application id for standalone (no k= tenant key). Default 36.
# ARMADA_APP_ID=36

# Optional. Used only if a reverse proxy already injects auth.
# VITE_ARMADA_API_BASE=/lt/api/v.1/applications/36

# --- Infra foundation (Phase Admin / Maintenance) ---
# Postgres (docker compose: npm run db:up)
# DATABASE_URL=postgres://fmplus:fmplus@127.0.0.1:5433/fmplus
# Encrypt Armada tokens stored in Postgres (32+ chars, or 64 hex)
# FMS_SECRETS_KEY=change-me-to-a-long-random-string

# Admin console bootstrap (creates first admin only when admin_users is empty)
# ADMIN_BOOTSTRAP_USER=admin
# ADMIN_BOOTSTRAP_PASSWORD=change-me-now
# Set ADMIN_COOKIE_SECURE=1 behind HTTPS
# ADMIN_COOKIE_SECURE=1
# Absolute base for Admin notifier URL templates
# PUBLIC_BASE_URL=https://81.17.100.7:4173

# S3-compatible object storage for PoM photos (MinIO via docker compose)
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY=fmplus
# S3_SECRET_KEY=fmplussecret
# S3_BUCKET=fmplus-pom
# S3_FORCE_PATH_STYLE=1

# Production server (`npm run build && npm start`)
# PORT=4173
# Optional HTTPS. Used automatically when ssl/server.key and ssl/server.crt exist.
# SSL_KEY=ssl/server.key
# SSL_CERT=ssl/server.crt
# Who may iframe this app. Default allows apex + any https subdomain of armada.id.
# EMBED_FRAME_ANCESTORS='self' https://armada.id https://*.armada.id

# Route plan — local OSRM (see docs/osrm.md). Without this, /route uses haversine.
# OSRM_BASE_URL=http://127.0.0.1:5000
# Optional: graph with Jakarta ganjil–genap corridors hard-blocked (fallback if exclude class missing)
# OSRM_BASE_URL_RESTRICTED=http://127.0.0.1:5001
# OSRM_GANJIL_GENAP_CLASS=ganjilgenap

# Build-time allowlist for parent postMessage (fms-embed:set).
# Default: https://armada.id,https://*.armada.id
# VITE_EMBED_ORIGINS=https://armada.id,https://*.armada.id

# Optional map tiles (browser). Default: Esri World Street Map (no API key).
# Do not use tile.openstreetmap.org (OSMF blocks apps → 403).
# VITE_MAP_TILE_PROVIDER=esri
# CARTO (needs free key from https://carto.com/basemaps/apikey ):
# VITE_MAP_TILE_PROVIDER=carto
# VITE_CARTO_API_KEY=your_carto_key
# Or full URL override:
# VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?apikey=YOUR_KEY
# VITE_MAP_TILE_MAX_ZOOM=20
# VITE_MAP_TILE_ATTR=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>

# Optional extra tenants as JSON (same shape as tenants.json). Prefer the file / Admin DB.
# TENANTS_JSON=

# Optional AI analysis (OpenAI-compatible). Server-side only — do not prefix with VITE_.
# Template analysis stays the default in the UI if this is unset.
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
